{
    "openapi": "3.0.0",
    "info": {
        "title": "LDS Temple API",
        "description": "API for LDS Temple information",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080"
        }
    ],
    "components": {
        "securitySchemes": {
            "apiKey": {
                "type": "apiKey",
                "in": "header",
                "name": "apiKey"
            }
        }
    },
    "paths": {
        "/temples": {
            "get": {
                "summary": "Get all temples",
                "description": "Returns a list of all LDS temples.",
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of temples"
                    },
                    "500": {
                        "description": "Error retrieving temples"
                    }
                }
            },
            "post": {
                "summary": "Create a new temple",
                "description": "Creates a new LDS temple.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "temple_id": {
                                        "type": "integer"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "location": {
                                        "type": "string"
                                    },
                                    "dedicated": {
                                        "type": "string"
                                    },
                                    "additionalInfo": {
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "temple_id",
                                    "name",
                                    "location",
                                    "dedicated",
                                    "additionalInfo"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Temple created successfully"
                    },
                    "400": {
                        "description": "Invalid temple data"
                    },
                    "500": {
                        "description": "Error creating temple"
                    }
                }
            }
        },
        "/temples/{temple_id}": {
            "get": {
                "summary": "Get a temple by ID",
                "description": "Returns a specific temple by its temple ID.",
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "parameters": [
                    {
                        "name": "temple_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The ID of the temple"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Temple found"
                    },
                    "404": {
                        "description": "Temple not found"
                    },
                    "500": {
                        "description": "Error retrieving temple"
                    }
                }
            },
            "put": {
                "summary": "Update a temple",
                "description": "Updates an existing LDS temple by its temple ID.",
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "parameters": [
                    {
                        "name": "temple_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The ID of the temple"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "location": {
                                        "type": "string"
                                    },
                                    "dedicated": {
                                        "type": "string"
                                    },
                                    "additionalInfo": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Temple updated successfully"
                    },
                    "400": {
                        "description": "Invalid temple data"
                    },
                    "401": {
                        "description": "Invalid apiKey"
                    },
                    "404": {
                        "description": "Temple not found"
                    },
                    "500": {
                        "description": "Error updating temple"
                    }
                }
            },
            "delete": {
                "summary": "Delete a temple",
                "description": "Deletes an existing LDS temple by its temple ID.",
                "security": [
                    {
                        "apiKey": []
                    }
                ],
                "parameters": [
                    {
                        "name": "temple_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The ID of the temple"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Temple deleted successfully"
                    },
                    "401": {
                        "description": "Invalid apiKey"
                    },
                    "404": {
                        "description": "Temple not found"
                    },
                    "500": {
                        "description": "Error deleting temple"
                    }
                }
            }
        }
    }
}